generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpponentType {
  bot
  human
  online
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Mirrors the client's own locally-computed Elo (src/logic/rating.ts) for the global
  /// leaderboard — the client remains the source of truth for the rating MATH (it already knows
  /// things the server doesn't, like a bot opponent's ELO, which bot games never touch the server
  /// for at all), this is just the synced number so it can be read by other users.
  bulletRating Int @default(1200) @map("bullet_rating")
  blitzRating  Int @default(1200) @map("blitz_rating")
  rapidRating  Int @default(1200) @map("rapid_rating")

  games           Game[]
  puzzleProgress  PuzzleProgress[]

  @@map("users")
}

model Game {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opponentType     OpponentType @map("opponent_type")
  opponentElo      Int?         @map("opponent_elo")
  /// Display name of the human opponent — online games only; null for local/bot games.
  opponentUsername String?      @map("opponent_username")
  /// Which color this row's own user played — online games only, lets history show "You won"
  /// instead of an ambiguous absolute "White won" (local/bot games have no fixed "you").
  color            String?      @map("player_color")
  result           String
  pgn              String
  timeControl      String       @map("time_control")
  isChess960       Boolean      @default(false) @map("is_chess960")
  playedAt         DateTime     @default(now()) @map("played_at")

  @@index([userId])
  @@map("games")
}

model PuzzleProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleDate  String    @map("puzzle_date")
  solved      Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  @@unique([userId, puzzleDate])
  @@map("puzzle_progress")
}
