generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpponentType {
  bot
  human
  online
}

enum TournamentStatus {
  lobby
  active
  finished
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Mirrors the client's own locally-computed Elo (src/logic/rating.ts) for the global
  /// leaderboard — the client remains the source of truth for the rating MATH (it already knows
  /// things the server doesn't, like a bot opponent's ELO, which bot games never touch the server
  /// for at all), this is just the synced number so it can be read by other users.
  bulletRating Int @default(1200) @map("bullet_rating")
  blitzRating  Int @default(1200) @map("blitz_rating")
  rapidRating  Int @default(1200) @map("rapid_rating")

  games           Game[]
  puzzleProgress  PuzzleProgress[]
  createdTournaments      Tournament[]
  tournamentParticipations TournamentParticipant[]

  @@map("users")
}

model Game {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opponentType     OpponentType @map("opponent_type")
  opponentElo      Int?         @map("opponent_elo")
  /// Display name of the human opponent — online games only; null for local/bot games.
  opponentUsername String?      @map("opponent_username")
  /// Which color this row's own user played — online games only, lets history show "You won"
  /// instead of an ambiguous absolute "White won" (local/bot games have no fixed "you").
  color            String?      @map("player_color")
  result           String
  pgn              String
  timeControl      String       @map("time_control")
  isChess960       Boolean      @default(false) @map("is_chess960")
  playedAt         DateTime     @default(now()) @map("played_at")

  @@index([userId])
  @@map("games")
}

/// A small (~8-player) friend-group knockout-free round-robin — every participant plays every
/// other participant exactly once. Live orchestration (who's paired with whom, whose game room is
/// active right now) lives entirely in-memory in TournamentManager (see backend/src/game/
/// tournaments.ts), same as an active game Room or a pending Challenge code — this row (and
/// TournamentParticipant below) is only the durable record of what was created/who joined/the
/// final points, not a source of truth the server reads back from to resume a tournament after a
/// restart (an in-progress tournament doesn't survive a server restart, same as an in-progress
/// game doesn't today).
model Tournament {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  initialSeconds   Int              @map("initial_seconds")
  incrementSeconds Int              @map("increment_seconds")
  isChess960       Boolean          @default(false) @map("is_chess960")
  isKingOfTheHill  Boolean          @default(false) @map("is_king_of_the_hill")
  status           TournamentStatus @default(lobby)
  creatorId        String           @map("creator_id")
  creator          User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now()) @map("created_at")

  participants TournamentParticipant[]

  @@map("tournaments")
}

model TournamentParticipant {
  id           String     @id @default(uuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 per win, 0.5 per draw, 0 per loss — mirrored from TournamentManager's in-memory tally
  /// after every finished match (see handleMatchFinished).
  points Float @default(0)

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model PuzzleProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleDate  String    @map("puzzle_date")
  solved      Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  @@unique([userId, puzzleDate])
  @@map("puzzle_progress")
}
